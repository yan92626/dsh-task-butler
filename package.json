{
  "name": "dsh-personal-secretary",
  "version": "0.6.0",
  "type": "module",
  "description": "任务管家（Task Butler）：DeepSeek Harness 的 AI 任务秘书插件。今日工作台回答「今天做什么 / 什么需要我」，一句话快捷捕获，任务队列按全局并发自动领取执行、优先级参与入队排序；08:30 晨间简报 + AI 日报 + Webhook 通知，定时复盘与经验/技能沉淀。",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "docs",
    "tests"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "yan92626",
    "url": "https://github.com/yan92626"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yan92626/dsh-task-butler.git"
  },
  "homepage": "https://github.com/yan92626/dsh-task-butler#readme",
  "bugs": {
    "url": "https://github.com/yan92626/dsh-task-butler/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "task-queue",
    "task-board",
    "ai-assistant",
    "morning-brief",
    "agent",
    "automation",
    "webhook"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/static-check.mjs && node --test tests/evolution-unit.mjs tests/briefs-unit.mjs",
    "test:static": "node tests/static-check.mjs",
    "test:unit": "node --test tests/evolution-unit.mjs tests/briefs-unit.mjs",
    "test:api": "python3 tests/api-check.py --base http://127.0.0.1:49224"
  }
}
